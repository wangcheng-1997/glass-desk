<Window x:Class="GlassDesk.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassDesk 设置"
        Width="620"
        Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="GlassDesk 窗口透明化" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#555">
            透明度快捷键作用于当前前台窗口；未指定隐藏目标时，Alt+H 也作用于当前前台窗口。不会默认启用鼠标穿透，也不会自动注入目标进程。
        </TextBlock>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="默认透明度（1-100）" />
            <TextBox x:Name="DefaultOpacityBox" Grid.Column="1" Padding="6" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="每次调整步长（1-99）" />
            <TextBox x:Name="StepBox" Grid.Column="1" Padding="6" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="增加透明度快捷键" />
            <TextBox x:Name="IncreaseHotkeyBox" Grid.Column="1" Padding="6" />
        </Grid>
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="降低透明度快捷键" />
            <TextBox x:Name="DecreaseHotkeyBox" Grid.Column="1" Padding="6" />
        </Grid>
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="恢复透明度快捷键" />
            <TextBox x:Name="ResetHotkeyBox" Grid.Column="1" Padding="6" />
        </Grid>
        <StackPanel Grid.Row="7" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Padding="10,6" Content="保存" Click="Save_Click" />
            <Button Width="90" Padding="10,6" Content="取消" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
